# --- LLMs (orchestrator + specialist agents) ---
# API key for NVIDIA-hosted NIM endpoints (build.nvidia.com)
NVIDIA_API_KEY=

# --- nvkit-redaction (Google Cloud DLP) ---
# Path to a Google Cloud service-account JSON with DLP API access
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- nvkit-transcription (NVIDIA Riva / Parakeet NIM) ---
# gRPC endpoint of a Riva server or Parakeet ASR NIM, e.g. localhost:50051
RIVA_SERVER=

# --- nvkit-tableau ---
TABLEAU_SERVER_URL=
TABLEAU_SITE_ID=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# --- nvkit-wordpress ---
WORDPRESS_URL=
WORDPRESS_USER=
# Application password (WP admin -> Users -> Application Passwords)
WORDPRESS_APP_PASSWORD=

# --- nvkit-meltwater ---
MELTWATER_API_TOKEN=
